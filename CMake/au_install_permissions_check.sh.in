set -euo pipefail

build_dir="@CMAKE_BINARY_DIR@"
destdir="@AU_INSTALL_PERMISSIONS_CHECK_DESTDIR@"
prefix="@AU_INSTALL_PERMISSIONS_CHECK_PREFIX@"
libdir="${prefix}/@CMAKE_INSTALL_LIBDIR@"
incdir="${prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
config="${1:-}"

fail() {
    echo "InstallPermissionsCheck FAILED: $1" >&2
    exit 1
}

case "${destdir}" in
    "${build_dir}"/*) ;;
    *) fail "refusing to clean path outside the build tree: ${destdir}" ;;
esac

# A clean tree and permissive group umask reproduce the packaging condition
# that originally produced group-writable install directories.
rm -rf -- "${destdir}"
umask 0002

install_args=(--install "${build_dir}" --component Unspecified)
if [ -n "${config}" ]; then
    install_args+=(--config "${config}")
fi
DESTDIR="${destdir}" "@CMAKE_COMMAND@" "${install_args[@]}"

[ -d "${prefix}" ] || fail "install prefix was not created: ${prefix}"

writable="$(find "${prefix}" -type d -perm /022 -print)"
[ -z "${writable}" ] || fail "group/other-writable installed director(ies):
${writable}"

for directory in "${libdir}" "${incdir}"; do
    [ -d "${directory}" ] || fail "expected directory was not installed: ${directory}"
    mode="$(stat -c '%a' "${directory}")"
    [ "${mode}" = "755" ] \
        || fail "directory ${directory} has mode ${mode}, expected 755"
done

ndirs="$(find "${prefix}" -type d | wc -l)"
echo "InstallPermissionsCheck PASSED: ${ndirs} directories checked under umask 0002"
